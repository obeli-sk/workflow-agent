// Generated by `obelisk generate wit-deps` from deployment.toml.
package obelisk-agent:agent;

interface session {
  record t0 { id: string, text: string }
  record t1 { id: string, script: string, stdin: string }
  variant t2 { prompt(t0), shell(t1) }
  record t3 { protocol-version: u32 }
  record t4 { id: string, text: string, turn-index: u64 }
  record t5 { id: string, script: string, stdin: string, turn-index: u64 }
  record t6 { content-json: string, turn-index: u64, duration-milliseconds: u64 }
  record t7 { turn-index: u64, duration-milliseconds: u64 }
  record t8 { stdout: string, stderr: string, exit-code: s32 }
  variant t9 { ok(t8), error(string) }
  record t10 { id: string, output: t9, turn-index: u64, duration-milliseconds: u64 }
  record t11 {
    id: string,
    script: string,
    %result: t8,
    turn-index: u64,
    duration-milliseconds: u64,
  }
  variant t12 {
    session-started(t3),
    operator-message(t4),
    shell-started(t5),
    assistant-reply(t6),
    turn-completed(t7),
    agent-error(t4),
    tool-result(t10),
    shell-output(t11),
  }

  injection: func() -> result<t2, string>;
  record-output: func(event-id: string) -> result<t12, string>;
}
