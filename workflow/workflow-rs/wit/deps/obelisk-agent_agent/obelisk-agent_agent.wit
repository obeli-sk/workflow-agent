// Generated by `obelisk generate wit-deps` from deployment.toml.
package obelisk-agent:agent;

interface session {
  record t0 { id: string, text: string }
  record t1 { id: string, script: string, stdin: string }
  variant t2 { prompt(t0), shell(t1) }
  record t3 { protocol-version: u32 }
  record t4 { id: string, text: string, turn-index: u64 }
  record t5 { content-json: string, turn-index: u64, duration-milliseconds: u64 }
  record t6 { stdout: string, stderr: string, exit-code: s32 }
  variant t7 { ok(t6), error(string) }
  record t8 { id: string, output: t7, turn-index: u64, duration-milliseconds: u64 }
  record t9 {
    id: string,
    script: string,
    %result: t6,
    turn-index: u64,
    duration-milliseconds: u64,
  }
  variant t10 {
    session-started(t3),
    operator-message(t4),
    assistant-reply(t5),
    agent-error(t4),
    tool-result(t8),
    shell-output(t9),
  }

  injection: func() -> result<t2, string>;
  record-output: func(event-id: string) -> result<t10, string>;
}
