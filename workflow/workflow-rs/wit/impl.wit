package obelisk-agent:workflow;

interface workflow {
  // Resolves a pack descriptor, then runs the session loop in this execution.
  run-cancellable: func(
    prompt: string,
    model: option<string>,
    descriptor-ffqn: option<string>,
    effort: option<string>,
  ) -> result<_, string>;
}

world any {
  export workflow;
  import obelisk:workflow/workflow-support@6.0.0;
}
