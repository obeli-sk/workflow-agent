use flake .

# ObeliskNet provisioner for `obelisk cloud`; without a token the shell has no cloud.
# export OBELISK_CLOUD_API_URL=https://api.obelisk.works
# export OBELISK_CLOUD_API_TOKEN=...

# Local backend: models are discovered from GET /v1/models.
export LLM_BASE_URL=http://127.0.0.1:9190

# Alternative endpoints with optional fallback catalogs (README has the details):
## Exe integration (in a VM: direct; outside: tunnel + examples/exe-llm-proxy.conf)
# export AGENT_MODELS="$(cat models.exe-integration.json)"
# export LLM_BASE_URL=https://llm.int.exe.xyz   # or http://localhost:7070 via the tunnel
## OpenRouter
# export AGENT_MODELS="$(cat models.openrouter.json)"
# export LLM_BASE_URL="https://openrouter.ai/api"
# export LLM_API_KEY="..."

# Obelisk version, used for constructing llms.txt URL and for fetching assets for `obelisk generate new`.
export OBELISK_VERSION="v$(obelisk -v | cut -d ' ' -f 2)"

# Optional: raises the GitHub API rate limit for fetching obeli-sk/* mounts.
# export GITHUB_MOUNT_TOKEN=$(gh auth token)
