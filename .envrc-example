use flake .

export OBELISK__API__TOKEN=$(obelisk generate token)

# Target Obelisk: the instance the agent inspects and deploys to.
export TARGET_OBELISK_API_URL=http://127.0.0.1:5205
export TARGET_OBELISK_API_URL_REGEX="http://127\\.0\\.0\\.1:5205"
export TARGET_OBELISK_TOKEN="$OBELISK__API__TOKEN"
# The target's webhook (external) listener; granted GET so the shell can curl
# deployed webhook endpoints, and printed by `mount`. Defaults to 9290 in
# server.toml/deployment.toml, matching server-target.toml.
export TARGET_OBELISK_WEBHOOK_URL="http://127.0.0.1:9290"

# Pick a catalog + endpoint (README has the details):
## Local
# export AGENT_MODELS="$(cat models.local.json)"
# export LLM_BASE_URL=http://127.0.0.1:9190
## Exe integration (in a VM: direct; outside: tunnel + examples/exe-llm-proxy.conf)
# export AGENT_MODELS="$(cat models.exe-integration.json)"
# export LLM_BASE_URL=https://llm.int.exe.xyz   # or http://localhost:7070 via the tunnel
## OpenRouter
# export AGENT_MODELS="$(cat models.openrouter.json)"
# export LLM_BASE_URL="https://openrouter.ai"
# export LLM_API_KEY="..."

export AGENT_MODELS="$(cat models.json)"        # ln -sf models.local.json models.json
export LLM_BASE_URL=http://127.0.0.1:9190
# export LLM_API_KEY=...

# Docs: pin the inlined llms.txt index to the target Obelisk version (empty =
# latest). See the README "Documentation" section.
export OBELISK_VERSION=""
