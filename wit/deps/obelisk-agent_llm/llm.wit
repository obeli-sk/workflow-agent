package obelisk-agent:llm;

interface chat {
  record completion-reply {
    content-json: string,
    stop-reason: string,
  }

  record rate-limit {
    retry-after-seconds: u32,
    message: string,
  }

  variant completion-result {
    reply(completion-reply),
    rate-limited(rate-limit),
  }

  // Carries new messages and accepted LLM execution IDs; the activity reconstructs history.
  completion: func(
    system: string,
    delta-json: string,
    tools-json: string,
    model: string,
    effort: string,
    history-ids: list<string>,
  ) -> result<completion-result, string>;
}

world exports {
  export chat;
}
