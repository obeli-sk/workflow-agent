package obelisk-agent:tools;

// This instance's execution controls, used by the UI webhook.
interface webapi {
  variant tool-error {
    permanent-error(string),
    transient-error(string),
    execution-failed,
  }

  enum action-kind {
    pause,
    unpause,
    cancel,
    stub,
  }

  record action-result {
    ok: bool,
    execution-id: string,
    action: action-kind,
    already: bool,
  }

  pause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  unpause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  cancel-execution: func(execution-id: string) -> result<action-result, tool-error>;
  stub-execution: func(execution-id: string, result-json: string) -> result<action-result, tool-error>;
}

// ObeliskNet (`obelisk cloud`), authenticated by OBELISK_CLOUD_API_TOKEN.
interface cloud {
  record command-output {
    stdout: string,
    stderr: string,
    exit-code: u32,
  }

  record deploy-target {
    api-url: string,
    log: string,
  }

  record deployed {
    webhook-url: option<string>,
    log: string,
  }

  // Provisioner commands (`obelisk cloud apps|token|app ...` minus deploy and app API calls).
  run: func(args: list<string>, stdin: string, app-toml: option<string>) -> result<command-output, string>;
  // Stage the app's config from `app-toml` or create the app, return where to enqueue the deployment.
  prepare-deploy: func(app: string, app-toml: string) -> result<deploy-target, string>;
  // Apply the config with the enqueued deployment and require the app to be running.
  finish-deploy: func(app: string, app-toml: string, deployment-id: string) -> result<deployed, string>;
  // One webapi `operation` with JSON positional params against the app's API; returns JSON.
  tenant: func(app: string, operation: string, params-json: string) -> result<string, string>;
  // `tenant` limited to read-only operations, so the runtime may retry it.
  tenant-read: func(app: string, operation: string, params-json: string) -> result<string, string>;
}
