package obelisk-agent:tools;

// This instance's execution controls, used by the UI webhook.
interface webapi {
  variant tool-error {
    permanent-error(string),
    transient-error(string),
    execution-failed,
  }

  enum action-kind {
    pause,
    unpause,
    cancel,
    stub,
  }

  record action-result {
    ok: bool,
    execution-id: string,
    action: action-kind,
    already: bool,
  }

  pause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  unpause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  cancel-execution: func(execution-id: string) -> result<action-result, tool-error>;
  stub-execution: func(execution-id: string, result-json: string) -> result<action-result, tool-error>;
}

// ObeliskNet (`obelisk cloud`), authenticated by OBELISK_CLOUD_API_TOKEN.
interface cloud {
  record command-output {
    stdout: string,
    stderr: string,
    exit-code: u32,
  }

  record deploy-target {
    created: bool,
    // Staged configuration revision that `finish-deploy` applies.
    revision: u64,
    log: string,
  }

  record deployed {
    app-json: string,
    log: string,
  }

  record response {
    status: u16,
    body: string,
  }

  // `fill-env` is the shell's exported variables when `--fill-non-interactive`
  // (or `fill --non-interactive`) asks for same-named values; none otherwise.

  // Provisioner commands (`obelisk cloud apps|token|app ...` minus deploy and app API calls).
  run: func(args: list<string>, stdin: string, app-toml: option<string>, fill-env: option<list<tuple<string, string>>>) -> result<command-output, string>;
  // Stage the app's config from `app-toml`, or create the app. The err carries the log so far.
  prepare-deploy: func(app: string, app-toml: string, fill-env: option<list<tuple<string, string>>>) -> result<deploy-target, string>;
  // Fill an app that was not `created`, apply the staged `revision` with the enqueued deployment and
  // require the app to be running; returns the app row. The err carries the log so far.
  finish-deploy: func(app: string, app-toml: string, deployment-id: string, revision: u64, created: bool, fill-env: option<list<tuple<string, string>>>) -> result<deployed, string>;
  // GET `path` (with its query) on the app's API; err only when no response arrived.
  tenant-read: func(app: string, path: string) -> result<response, string>;
  // Any other request on the app's API, sent once.
  tenant: func(app: string, method: string, path: string, content-type: option<string>, body: option<string>) -> result<response, string>;
}
