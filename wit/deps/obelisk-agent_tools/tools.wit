package obelisk-agent:tools;

// This instance's execution controls, used by the UI webhook.
interface webapi {
  variant tool-error {
    permanent-error(string),
    transient-error(string),
    execution-failed,
  }

  enum action-kind {
    pause,
    unpause,
    cancel,
    stub,
  }

  record action-result {
    ok: bool,
    execution-id: string,
    action: action-kind,
    already: bool,
  }

  pause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  unpause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  cancel-execution: func(execution-id: string) -> result<action-result, tool-error>;
  stub-execution: func(execution-id: string, result-json: string) -> result<action-result, tool-error>;
}

// ObeliskNet (`obelisk cloud`), authenticated by OBELISK_CLOUD_API_TOKEN.
interface cloud {
  record command-output {
    stdout: string,
    stderr: string,
    exit-code: u32,
  }

  record response {
    status: u16,
    body: string,
  }

  // `fill-env` is the shell's exported variables when `--fill-non-interactive`
  // (`cloud app stage`) asks for same-named values, or those that bare
  // `--env NAME` reads; none otherwise. Secret values never pass through here.

  // Provisioner reads and draft edits; creation, lifecycle and app API calls run separately.
  run: func(args: list<string>, stdin: string, app-toml: option<string>, fill-env: option<list<tuple<string, string>>>) -> result<command-output, string>;
  // One app creation request with an immutable JSON body and a workflow-chosen Idempotency-Key.
  create: func(body: string, command-id: string) -> result<response, string>;
  // Reuse a stage draft, or recover a unique deploy draft opened on the captured parent.
  draft-open: func(app: string, draft: string, parent-revision: u64, reuse: bool) -> result<response, string>;
  // One retryable edit to an existing draft, without implicit draft recreation.
  draft-request: func(app: string, draft: string, draft-id: u64, method: string, section: list<string>, content-type: option<string>, body: option<string>) -> result<response, string>;
  // GET `/<path>` on the provisioner; err only when no response arrived or the server failed.
  read: func(path: list<string>) -> result<response, string>;
  // `app apply|enable|disable|delete`: one request on `/v1/apps/<app>/<path>` with a JSON `body`.
  // `command-id` is its Idempotency-Key, so a retry joins the command or gets its recorded result.
  // Err only when no response arrived or the server failed.
  command: func(app: string, method: string, path: list<string>, body: option<string>, command-id: string, draft-id: option<u64>) -> result<response, string>;
  // GET `path` (with its query) on the app's API; err only when no response arrived.
  tenant-read: func(app: string, path: string) -> result<response, string>;
  // One retryable PUT of a content-addressed file or a workflow-chosen deployment ID.
  upload: func(app: string, path: string, content-type: option<string>, body: option<string>) -> result<response, string>;
  // Any other request on the app's API, sent once.
  tenant: func(app: string, method: string, path: string, content-type: option<string>, body: option<string>) -> result<response, string>;
}
