package obelisk-agent:tools;

// This instance's execution controls, used by the UI webhook.
interface webapi {
  variant tool-error {
    permanent-error(string),
    transient-error(string),
    execution-failed,
  }

  enum action-kind {
    pause,
    unpause,
    cancel,
    stub,
  }

  record action-result {
    ok: bool,
    execution-id: string,
    action: action-kind,
    already: bool,
  }

  pause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  unpause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  cancel-execution: func(execution-id: string) -> result<action-result, tool-error>;
  stub-execution: func(execution-id: string, result-json: string) -> result<action-result, tool-error>;
}

// ObeliskNet (`obelisk cloud`), authenticated by OBELISK_CLOUD_API_TOKEN.
interface cloud {
  record command-output {
    stdout: string,
    stderr: string,
    exit-code: u32,
  }

  record deploy-target {
    created: bool,
    // Draft an existing app's changes were staged in, created for this deploy.
    draft: option<string>,
    // Configuration revision that `finish-deploy` re-applies without `draft`.
    revision: u64,
    log: string,
  }

  record deployed {
    app-json: string,
    log: string,
  }

  record response {
    status: u16,
    body: string,
  }

  // `fill-env` is the shell's exported variables when `--fill-non-interactive`
  // (`cloud app new`) asks for same-named values, or those that bare
  // `--env NAME` and `--secret NAME` read; none otherwise.

  // Provisioner commands (`obelisk cloud auth|app ...` minus deploy, lifecycle and app API calls).
  run: func(args: list<string>, stdin: string, app-toml: option<string>, fill-env: option<list<tuple<string, string>>>) -> result<command-output, string>;
  // Create `draft` of an existing app exclusively and stage `app-toml`, the `--env` and `--secret`
  // arguments and, with `fill`, the declared values of `exported` into it, requiring every declared
  // value and discarding the draft on failure, or create the app with them. `exported` holds the shell's exported variables that bare names and `fill` read.
  // The err carries the log so far.
  prepare-deploy: func(app: string, app-toml: string, draft: string, env: list<string>, secrets: list<string>, fill: bool, exported: list<tuple<string, string>>) -> result<deploy-target, string>;
  // Apply `draft`, or re-apply `revision` without one, with the uploaded deployment,
  // and require the app to be running; returns the app row. The err carries the log so far.
  // `command-id` is the apply's Idempotency-Key, stable across retries: deploying the app this runs in
  // interrupts the call, and the retry picks up the apply's recorded result.
  finish-deploy: func(app: string, deployment-id: string, revision: u64, draft: option<string>, command-id: string) -> result<deployed, string>;
  // GET `/<path>` on the provisioner; err only when no response arrived or the server failed.
  read: func(path: list<string>) -> result<response, string>;
  // `app apply|enable|disable|delete`: one request on `/v1/apps/<app>/<path>` with a JSON `body`.
  // `command-id` is its Idempotency-Key, so a retry joins the command or gets its recorded result.
  // Err only when no response arrived or the server failed.
  command: func(app: string, method: string, path: list<string>, body: option<string>, command-id: string) -> result<response, string>;
  // GET `path` (with its query) on the app's API; err only when no response arrived.
  tenant-read: func(app: string, path: string) -> result<response, string>;
  // Any other request on the app's API, sent once.
  tenant: func(app: string, method: string, path: string, content-type: option<string>, body: option<string>) -> result<response, string>;
}
