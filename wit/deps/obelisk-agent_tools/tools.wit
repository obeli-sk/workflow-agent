package obelisk-agent:tools;

// This instance's execution controls, used by the UI webhook.
interface webapi {
  variant tool-error {
    permanent-error(string),
    transient-error(string),
    execution-failed,
  }

  enum action-kind {
    pause,
    unpause,
    cancel,
    stub,
  }

  record action-result {
    ok: bool,
    execution-id: string,
    action: action-kind,
    already: bool,
  }

  pause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  unpause-execution: func(execution-id: string) -> result<action-result, tool-error>;
  cancel-execution: func(execution-id: string) -> result<action-result, tool-error>;
  stub-execution: func(execution-id: string, result-json: string) -> result<action-result, tool-error>;
}

// ObeliskNet (`obelisk cloud`), authenticated by OBELISK_CLOUD_API_TOKEN.
interface cloud {
  record command-output {
    stdout: string,
    stderr: string,
    exit-code: u32,
  }

  record deploy-target {
    created: bool,
    // Draft an existing app's changes were staged in; it keeps them when the deploy fails.
    draft: option<string>,
    // Whether `draft` differs from the applied revision; otherwise the applied revision is re-applied.
    changed: bool,
    // Configuration revision that `finish-deploy` applies.
    revision: u64,
    log: string,
  }

  record deployed {
    app-json: string,
    log: string,
  }

  record response {
    status: u16,
    body: string,
  }

  // `fill-env` is the shell's exported variables when `--fill-non-interactive`
  // (or `fill --non-interactive`) asks for same-named values, or those that bare
  // `--env NAME` and `--secret NAME` read; none otherwise.

  // Provisioner commands (`obelisk cloud auth|app ...` minus deploy and app API calls).
  run: func(args: list<string>, stdin: string, app-toml: option<string>, fill-env: option<list<tuple<string, string>>>) -> result<command-output, string>;
  // Stage `app-toml`, the `--env` and `--secret` arguments and, with `fill`, the declared values of
  // `exported` into `draft` of an existing app, requiring every declared value, or create the app
  // with them. `exported` holds the shell's exported variables that bare names and `fill` read.
  // The err carries the log so far.
  prepare-deploy: func(app: string, app-toml: string, draft: string, env: list<string>, secrets: list<string>, fill: bool, exported: list<tuple<string, string>>) -> result<deploy-target, string>;
  // Apply `revision` (of `draft` when given) with the uploaded deployment, then delete draft
  // `discard` when given, and require the app to be running; returns the app row. The err carries the log so far.
  // `command-id` is the apply's Idempotency-Key, stable across retries: deploying the app this runs in
  // interrupts the call, and the retry picks up the apply's recorded result.
  finish-deploy: func(app: string, deployment-id: string, revision: u64, draft: option<string>, discard: option<string>, command-id: string) -> result<deployed, string>;
  // GET `path` (with its query) on the app's API; err only when no response arrived.
  tenant-read: func(app: string, path: string) -> result<response, string>;
  // Any other request on the app's API, sent once.
  tenant: func(app: string, method: string, path: string, content-type: option<string>, body: option<string>) -> result<response, string>;
}
