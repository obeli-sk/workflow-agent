package obelisk-agent:workflow;

interface workflow {
  run-cancellable: func(
    prompt: string,
    model: option<string>,
    descriptor-ffqn: option<string>,
    effort: option<string>,
    name: option<string>,
    // openai-chat-completions, openai-responses or anthropic-messages; none uses the model's configured API.
    api: option<string>,
  ) -> result<_, string>;
}

world exports {
  export workflow;
}
