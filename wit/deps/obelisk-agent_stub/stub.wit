package obelisk-agent:stub;

interface stub {
  record prompt-input {
    id: string,
    text: string,
  }

  record shell-input {
    id: string,
    script: string,
    stdin: string,
  }

  // Stop the current turn: delivered through the same live input offer as
  // prompt/shell, so it races the in-flight LLM completion instead of
  // needing its own channel. Applied at the next safe boundary (the
  // outstanding completion is still drained, its reply just discarded).
  record interrupt-input {
    id: string,
  }

  variant session-input {
    prompt(prompt-input),
    shell(shell-input),
    interrupt(interrupt-input),
  }

  record session-started-event {
    protocol-version: u32,
    prompt: string,
    backend: string,
    effort: string,
    system-prompt: string,
  }

  record input-offered-event {
    execution-id: string,
    turn-index: u64,
  }

  record agent-status-event {
    working: bool,
    turn-index: u64,
  }

  // Published when a bash script starts, carrying the interrupt offer's
  // execution id so the UI (on that script's transcript card) and peer
  // sessions (`chat interrupt`) can arm it while the script runs.
  record shell-started-event {
    id: string,
    offer-id: string,
    turn-index: u64,
  }

  record human-input-requested-event {
    execution-id: string,
    question: string,
    turn-index: u64,
  }

  record human-input-resolved-event {
    execution-id: string,
    turn-index: u64,
  }

  record user-message-event {
    id: string,
    text: string,
    turn-index: u64,
  }

  record agent-error-event {
    id: string,
    text: string,
    turn-index: u64,
  }

  record session-renamed-event {
    name: string,
  }

  record assistant-reply-event {
    content-json: string,
    turn-index: u64,
    duration-milliseconds: u64,
    turn-complete: bool,
  }

  variant output-chunk {
    stdout(string),
    stderr(string),
  }

  record shell-result {
    // stdout and stderr interleaved in write order, so a reader can see which
    // stderr line landed between which stdout lines (two flat strings cannot).
    output: list<output-chunk>,
    exit-code: s32,
    // Set when the script was cut short at a durable boundary before its
    // natural end: "timeout" (the tool's watchdog fired) or "operator"
    // (someone wrote the interrupt offer). Exit codes follow: 124 and 130.
    interrupted: option<string>,
  }

  variant tool-output {
    ok(shell-result),
    error(string),
  }

  record tool-result-event {
    id: string,
    output: tool-output,
    turn-index: u64,
    duration-milliseconds: u64,
  }

  record shell-output-event {
    id: string,
    script: string,
    %result: shell-result,
    turn-index: u64,
    duration-milliseconds: u64,
    turn-complete: bool,
  }

  variant session-event {
    session-started(session-started-event),
    input-offered(input-offered-event),
    agent-status(agent-status-event),
    shell-started(shell-started-event),
    human-input-requested(human-input-requested-event),
    human-input-resolved(human-input-resolved-event),
    user-message(user-message-event),
    assistant-reply(assistant-reply-event),
    agent-error(agent-error-event),
    session-renamed(session-renamed-event),
    tool-result(tool-result-event),
    shell-output(shell-output-event),
  }

  injection: func() -> result<session-input, string>;
  record-output: func() -> result<session-event, string>;
  // Renames publish on their own join set (never through record-output), so
  // consumers fetch a session's current name with one bounded request instead
  // of racing the mixed event stream.
  session-renamed: func(name: string) -> result<session-renamed-event, string>;
  ask-user: func(question: string) -> result<string, string>;
  // Per-script interrupt offer: the session submits one child per bash script;
  // writing its result aborts that script at the next durable boundary (exit
  // 130) while the session itself stays alive. The ok payload is a short free
  // text reason ("operator", "peer:<session-id>", ...).
  interrupt: func() -> result<string, string>;
}

world exports {
  export stub;
}
