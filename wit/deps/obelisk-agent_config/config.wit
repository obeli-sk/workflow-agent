package obelisk-agent:config;

// Session settings the workflow discovers once at start
// (activity/config-discover.js backs this interface, reading the
// PROGRAMS_JSON/APPS_JSON/MAX_STEPS env vars), so operator
// config changes take effect without redeploying the workflow.
interface config {
  record program {
    name: string,
    ffqn: string,
    description: string,
  }

  // A GitHub repo tree mounted read-only at /workspace/apps/<name>
  // (obelisk_web/obelisk-web.js -> the mount_apps activity). `description`
  // is surfaced in the system prompt so the model knows what the repo is
  // and how to use it.
  record app {
    name: string,
    owner: string,
    repo: string,
    ref: string,
    description: string,
  }

  record session-config {
    max-steps: u32,
    programs: list<program>,
    apps: list<app>,
    webhook-url: string,
    // The obelisk repo ref (`vX.Y.Z` or `latest`) that `obelisk generate new` fetches the starter from.
    obelisk-version: string,
    // The whole tail of the system prompt after "# Example apps": user-input
    // guidance, subagent delegation, deployment authoring, and the
    // per-session "# This session" text.
    prompt-tail: string,
  }

  discover: func(execution-id: string, backend: string, effort: string, name: option<string>) -> result<session-config, string>;
  input-accepted-at: func(execution-id: string) -> result<u64, string>;
}
